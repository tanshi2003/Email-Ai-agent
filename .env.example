# Copy this file to .env and fill in credentials for a dedicated test mailbox.
# Never commit .env or share credentials.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
POLL_INTERVAL_SECONDS=60
ALLOWED_SENDERS=

# Optional Gemini provider. auto mode falls back to rule-based replies on API errors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
REPLY_PROVIDER=auto
