# Copy this file to .env and fill in credentials for your own test mailbox.
# Never commit .env or share either secret.
GMAIL_USERNAME=your-test-account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
POLL_INTERVAL_SECONDS=60

# Optional: enables LLM-generated drafts. Without a key, rule-based fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REPLY_PROVIDER=auto
